# URL da API do Zabbix, ex.: https://zabbix.exemplo.com/api_jsonrpc.php
ZABBIX_URL=
# Token de API de um usuário somente leitura
ZABBIX_API_TOKEN=
# Chave que o Copilot usa para chamar este conector (cabeçalho X-API-Key)
CONNECTOR_API_KEY=

# Opcionais
# Verificar o certificado TLS do Zabbix (true/false)
ZABBIX_VERIFY_SSL=true
# Tempo limite das chamadas ao Zabbix, em segundos
ZABBIX_TIMEOUT=15
# Itens por resposta quando o Copilot não informa "limite", e o máximo aceito
DEFAULT_LIMIT=50
MAX_LIMIT=200
# Teto de hosts lidos para montar o resumo de /disponibilidade
AVAILABILITY_SCAN_MAX=5000
